# -----------------------------------------------------------------------------
# Terraform
# -----------------------------------------------------------------------------

# Рабочая директория Terraform (генерируемые файлы, кэш модулей и т.п.)
.terraform/

# Файлы состояния Terraform (содержат текущее состояние инфраструктуры — крайне чувствительны!)
*.tfstate
*.tfstate.*

# Логи сбоев Terraform (могут содержать стек-трейсы и частичную информацию о ресурсах)
crash.log

# Конфигурационные файлы CLI Terraform (локальные настройки пользователя)
.terraformrc
terraform.rc

# Файл блокировки версий провайдеров (фиксирует точные версии провайдеров; обычно КОММИТЯТ в репозиторий, но здесь оставлен в ignore по шаблону — см. примечание ниже)
.terraform.lock.hcl
# ПРИМЕЧАНИЕ: В большинстве production-проектов .terraform.lock.hcl РЕКОМЕНДУЕТСЯ КОММИТИТЬ, чтобы гарантировать воспроизводимость сборки на всех машинах.

# Файлы переменных, которые могут содержать секреты (никогда не коммить!)
*.tfvars
*.tfvars.json
*.terraform.tfvars

# Файлы переопределений (могут менять поведение конфигурации — часто локальные)
override.tf
override.tf.json
*_override.tf
*_override.tf.json


# -----------------------------------------------------------------------------
# Секреты и чувствительные данные
# -----------------------------------------------------------------------------

# Криптографические ключи и сертификаты (строго запрещено коммитить!)
*.pem
*.key
*.pub
*.pfx
*.p12

# SSH-ключи (личные ключи пользователя — не должны попадать в репозиторий)
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Ключи доступа Yandex Cloud (JSON-файлы с IAM-ключами — высокочувствительные)
*.json
# ПРИМЕЧАНИЕ: Если в проекте есть несекретные JSON-файлы (например, конфиги), можно добавить исключения через !<pattern>.


# -----------------------------------------------------------------------------
# Ansible (с учётом твоего опыта работы с Ansible)
# -----------------------------------------------------------------------------

# Сгенерированный инвентарь и локальная конфигурация Ansible
inventory.ini
ansible.cfg
inventory.yml

# Файлы повторных попыток Ansible (локальная статистика выполнения)
*.retry

# Секреты Ansible (зашифрованные vault-файлы в group_vars/host_vars)
group_vars/*vault.yml
host_vars/*vault.yml
# Исключения: оставляем .gitkeep, чтобы папки существовали в репозитории даже без файлов
!group_vars/.gitkeep
!host_vars/.gitkeep


# -----------------------------------------------------------------------------
# Логи и временные файлы
# -----------------------------------------------------------------------------

# Любые логи (могут содержать PII, ошибки, частичные данные)
*.log

# Временные и резервные файлы (создаются редакторами, скриптами, утилитами)
*.tmp
*.bak
*.swp
*.swo

# Пароли для Ansible Vault (никогда не хранить в Git!)
*.vault_pass
.vault_pass


# -----------------------------------------------------------------------------
# Python и виртуальные окружения
# -----------------------------------------------------------------------------

# Кэш байт-кода Python
__pycache__/
*.py[cod]
*$py.class

# Виртуальные окружения (изолированные среды — локальны для разработчика)
venv/
.env/
env/
ENV/
env.bak/
venv.bak/

# Переменные окружения (часто содержат секреты)
.env

# C-расширения и скомпилированные модули
*.so


# -----------------------------------------------------------------------------
# Упаковка, сборка и дистрибуция Python
# -----------------------------------------------------------------------------

.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST


# -----------------------------------------------------------------------------
# Инструменты сборки и упаковки (PyInstaller, установщики)
# -----------------------------------------------------------------------------

*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt


# -----------------------------------------------------------------------------
# Тесты, покрытие кода, CI/CD артефакты
# -----------------------------------------------------------------------------

htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/


# -----------------------------------------------------------------------------
# Локализация и переводы
# -----------------------------------------------------------------------------

*.mo
*.pot


# -----------------------------------------------------------------------------
# Фреймворки и специфичные инструменты (Django, Flask, Scrapy, Sphinx и др.)
# -----------------------------------------------------------------------------

# Django
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask
instance/
.webassets-cache

# Scrapy
.scrapy

# Sphinx (сборка документации)
docs/_build/

# PyBuilder
.pybuilder/
target/


# -----------------------------------------------------------------------------
# Jupyter, IPython, аналитика
# -----------------------------------------------------------------------------

.ipynb_checkpoints
profile_default/
ipython_config.py


# -----------------------------------------------------------------------------
# Менеджеры зависимостей Python (Pipenv, UV, Poetry, PDM)
# -----------------------------------------------------------------------------

# pyenv (версия интерпретатора — часто не коммитится для библиотек, но коммитится для приложений)
# .python-version

# Pipenv (lock-файл обычно КОММИТЯТ для воспроизводимости — здесь закомментировано)
# Pipfile.lock

# UV (lock-файл обычно КОММИТЯТ, особенно для бинарных пакетов)
# uv.lock

# Poetry (lock-файл обычно КОММИТЯТ — обеспечивает одинаковые зависимости у всех)
# poetry.lock

# PDM (lock-файл КОММИТЯТ; конфиг проекта — нет)
pdm.lock
.pdm.toml
.pdm-python
.pdm-build/

# PEP 582 (автоматические пакеты)
__pypackages__/


# -----------------------------------------------------------------------------
# Фоновые задачи, очереди, математика
# -----------------------------------------------------------------------------

celerybeat-schedule
celerybeat.pid
*.sage.py


# -----------------------------------------------------------------------------
# IDE, редакторы, инструменты анализа кода
# -----------------------------------------------------------------------------

# VS Code
.vscode/

# JetBrains (IntelliJ, PyCharm, WebStorm и т.д.)
.idea/

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject

# MkDocs (собранная документация)
/site

# mypy (кэш проверки типов)
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre
.pyre/

# pytype
.pytype/

# Cython (отладочные символы)
cython_debug/

# Ruff (кэш линтера)
.ruff_cache/

# Cursor (AI-редактор: файлы игнорирования для AI-функций)
.cursorignore
.cursorindexingignorefiles/*

# PyPI (конфигурация загрузки пакетов — локальная)
.pypirc


# -----------------------------------------------------------------------------
# Системные файлы ОС
# -----------------------------------------------------------------------------

.DS_Store          # macOS
Thumbs.db          # Windows


# -----------------------------------------------------------------------------
# Kubernetes и Helm
# -----------------------------------------------------------------------------

# Секреты Kubernetes (никогда не коммитить манифесты секретов!)
*secret*.yaml
*secret*.yml
secrets/

# Локальные конфиги и временные файлы kubectl
kubeconfig
.kube/
config.local.yaml

# Helm (менеджер пакетов Kubernetes)
.helm/
chart/charts/
chart/Chart.lock
chart/requirements.lock
helm-charts/
*.tgz

# Skaffold (инструмент локальной разработки/деплоя)
.skaffold/
